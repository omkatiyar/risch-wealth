# Copy to .env and adjust for your environment. Not committed (see .gitignore).

PORT=4000

# Bind address. Leave as 127.0.0.1 in production — nginx (on the same
# server) is the only thing that should reach this process directly.
HOST=127.0.0.1

# Comma-separated list of non-localhost origins allowed to call the API
# directly (same-origin requests via the nginx/Vite proxy don't need this
# at all, and any http://localhost:<port> / http://127.0.0.1:<port> origin
# is always allowed for local dev). Defaults to https://rischwealth.com
# + https://www.rischwealth.com if unset.
# CORS_ORIGIN=https://rischwealth.com,https://www.rischwealth.com
