RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}

# React Router client-side routes (e.g. /about, /risk-profiler) are not
# real files on the server — fall back to index.html so the SPA router
# can handle them, same as the original multi-page site's URLs did
# natively via Apache.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

ErrorDocument 403     /cgi-sys/403_def.html
ErrorDocument 404     /cgi-sys/404_def.html
ErrorDocument 500     /cgi-sys/500_def.html
ErrorDocument 502     /cgi-sys/502_def.html
ErrorDocument 503     /cgi-sys/503_def.html
ErrorDocument 504     /cgi-sys/504_def.html

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
